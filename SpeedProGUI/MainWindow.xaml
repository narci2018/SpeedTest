          <!-- ════════════════════ PINGULARITY PANEL ════════════════════ -->
          <StackPanel x:Name="PanelPingularity" Grid.Row="0" Visibility="Hidden">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="300"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="PINGULARITY SERVICE" FontSize="13" FontWeight="SemiBold"
                               Foreground="#A78BFA" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Port" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" x:Name="PingularityPort" FontSize="12" Padding="10,6"
                               Text="19000" VerticalAlignment="Center"/>
