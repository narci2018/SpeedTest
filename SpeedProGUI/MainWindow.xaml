                               Text="www.baidu.com" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" x:Name="DnsRunBtn" Content="Run" Style="{StaticResource PrimaryBtn}"
                              Height="32" Padding="16,0" MinWidth="100" Click="DnsRunBtn_Click"/>
                    </Grid>
