                               FontFamily="{StaticResource UiFont}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="240">
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <TextBlock Text="SERVICE LOG" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                      <Button Content="Clear" Style="{StaticResource GhostBtn}"
                              HorizontalAlignment="Right" Click="PingularityClearLog_Click"/>
                    </Grid>
                    <Border CornerRadius="8" Background="{DynamicResource CardSunkenBrush}"
                            BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
