                    </TextBlock>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="MONITORING CAPABILITIES" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Border Width="6" Height="6" Background="{DynamicResource SuccessBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
