                    <TextBlock Text="Download" FontSize="10" Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}" Margin="5,0,12,0"/>
                    <Rectangle Width="12" Height="3" Fill="#A78BFA" VerticalAlignment="Center"/>
                    <TextBlock Text="Upload" FontSize="10" Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}" Margin="5,0,12,0"/>
                    <Rectangle Width="12" Height="3" Fill="#FFD740" VerticalAlignment="Center"/>
                    <TextBlock Text="Ping (ms)" FontSize="10" Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}" Margin="5,0,0,0"/>
                  </StackPanel>
                </Grid>
                <Border CornerRadius="8" Background="{DynamicResource CardSunkenBrush}"
                        BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                  <Canvas x:Name="HistoryChartCanvas" Height="150" ClipToBounds="True"/>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="0">
              <DataGrid x:Name="HistoryGrid" Style="{StaticResource HistoryDataGrid}"/>
            </Border>
          </StackPanel>

          <!-- ════════════════════ SETTINGS PANEL ════════════════════ -->
          <StackPanel x:Name="PanelSettings" Grid.Row="0" Visibility="Hidden">
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="280"/></Grid.ColumnDefinitions>

              <!-- Left: Engine config -->
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="SetEngineTitle" Text="ENGINE CONFIGURATION" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,14"/>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock x:Name="SetEngineLabel" Text="Default Engine" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <ComboBox x:Name="SettingEngine" FontSize="12" Padding="10,7" SelectedIndex="0"
                                SelectionChanged="SettingEngine_Changed" FontFamily="{StaticResource UiFont}">
                        <ComboBoxItem Content="LibreSpeed CLI"/><ComboBoxItem Content="speedtest-go (Ookla servers)"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock x:Name="SetServerLabel" Text="Test Server" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <TextBox x:Name="SettingServer" FontSize="12" Padding="10,7"
                               Text="speedtest.dukekunshan.edu.cn" FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock x:Name="SetDurationLabel" Text="Test Duration (seconds)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <Slider x:Name="SettingDuration" Grid.Column="0" Minimum="5" Maximum="60"
                                Value="15" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                ValueChanged="SettingDuration_ValueChanged" FontFamily="{StaticResource UiFont}"/>
                        <TextBlock Grid.Column="1" x:Name="SettingDurationVal" Text="15s" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource UiFont}" HorizontalAlignment="Right" Margin="8,12,0,0" VerticalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock x:Name="SetThreadsLabel" Text="Concurrent Threads" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <Slider x:Name="SettingThreads" Minimum="1" Maximum="16" Value="4"
                              TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                              ValueChanged="SettingThreads_ValueChanged" FontFamily="{StaticResource UiFont}"/>
                      <TextBlock x:Name="SettingThreadsVal" Text="4 threads" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Background="{DynamicResource CardSunkenBrush}" CornerRadius="8"
                            Padding="14" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                      <StackPanel>
                        <TextBlock x:Name="SetEnginesLabel" Text="Available Engines" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                          <Border Width="8" Height="8" Background="{DynamicResource SuccessBrush}" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Text="speedtest-go.exe" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                          <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                          <Border Width="8" Height="8" Background="{DynamicResource SuccessBrush}" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Text="librespeed-cli.exe" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                          <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                          <Border Width="8" Height="8" Background="{DynamicResource SuccessBrush}" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Text="ethr.exe" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                          <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                          <Border Width="8" Height="8" Background="{DynamicResource SuccessBrush}" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Text="iperf3.exe + cygwin1.dll" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                          <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <Border Width="8" Height="8" Background="{DynamicResource SuccessBrush}" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <TextBlock Text="pingularity.exe" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                          <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Right: Theme + About -->
              <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="SetGeneralTitle" Text="GENERAL" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SetTrayCheck" Content="Minimize to tray" FontSize="12"
                              Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"
                              Margin="0,0,0,10" Checked="TrayCheck_Changed" Unchecked="TrayCheck_Changed"/>
                    <CheckBox x:Name="SetAutoStartCheck" Content="Start with Windows" FontSize="12"
                              Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"
                              Margin="0,0,0,10" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                    <CheckBox x:Name="SetAutoThemeCheck" Content="Follow system theme" FontSize="12"
                              Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"
                              Checked="AutoTheme_Changed" Unchecked="AutoTheme_Changed"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="SetAppearanceTitle" Text="APPEARANCE" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <Grid Margin="0,2,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="SetThemeLabel" Grid.Column="0" Text="Active Theme" FontSize="12"
                                 Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                      <TextBlock x:Name="SetThemeValue" Grid.Column="1" Text="Dark Tech" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource UiFont}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="SetProxyTitle" Text="PROXY SERVER" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SetProxyHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,8"/>
                    <TextBox x:Name="SettingProxy" FontSize="12" Padding="10,7"
                             TextChanged="SettingProxy_TextChanged" FontFamily="{StaticResource UiFont}"/>
                    <TextBlock x:Name="SettingProxyState" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="SetAboutTitle" Text="About SpeedPro" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               LineHeight="22" FontFamily="{StaticResource UiFont}">
                      <Run Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold">SpeedPro v3.9.0</Run><LineBreak/>
                      Professional network performance analysis suite.<LineBreak/>
                      Integrating 5 open-source measurement engines.<LineBreak/><LineBreak/>
                      <Run Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">Engines:</Run><LineBreak/>
                      speedtest-go (Ookla), LibreSpeed CLI, Microsoft Ethr,<LineBreak/>
                      iperf3 (TCP/UDP throughput), Pingularity (24/7 monitoring)<LineBreak/><LineBreak/>
                      <Run Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold">Architecture:</Run>
                      WPF .NET 8 | Cross-platform (x64/ARM64)<LineBreak/><LineBreak/>
                      <Run Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold">Themes:</Run>
                      黑科技 Dark Tech · 经典浅白 Classic Light
                    </TextBlock>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="SetSystemTitle" Text="System" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SysHostname" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SysOS" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SysArch" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="{StaticResource UiFont}"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                  <StackPanel>
                    <TextBlock x:Name="SetActionsTitle" Text="Quick Actions" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <Button x:Name="CheckUpdateBtn" Content="Check Updates" Style="{StaticResource SecondaryBtn}"
                            Height="34" Padding="16,0" Margin="0,0,0,8" Click="CheckUpdate_Click" Width="180" FontFamily="{StaticResource UiFont}"/>
                    <Button x:Name="OpenLogBtn" Content="Open Log Directory" Style="{StaticResource SecondaryBtn}"
                            Height="34" Padding="16,0" Margin="0,0,0,8" Click="OpenLogDir_Click" Width="180" FontFamily="{StaticResource UiFont}"/>
                    <Button x:Name="RefreshBtn" Content="Refresh Engine Status" Style="{StaticResource SecondaryBtn}"
                            Height="34" Padding="16,0" Click="RefreshEngines_Click" Width="180" FontFamily="{StaticResource UiFont}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>

          </Grid>
        </ScrollViewer>

        <!-- Fixed bottom row: log + results summary -->
        <Border x:Name="BottomRow" Grid.Row="1" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,1,0,0">
          <Grid Margin="24,10,24,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" MinWidth="320"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <!-- Log -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
              <StackPanel>
                <!-- Header: TEST LOG + progress bar + stage + clear -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="LogTitle" Grid.Column="0" Text="TEST LOG" FontSize="12"
                             FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                             FontFamily="{StaticResource UiFont}"/>
                  <Border x:Name="ProgressCardOuter" Grid.Column="1" Height="12" CornerRadius="6"
                          Background="{DynamicResource CardSunkenBrush}"
                          BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1"
                          VerticalAlignment="Center" Margin="12,0">
                    <Border x:Name="ProgressCardFill" Height="10" CornerRadius="5"
                            Background="{DynamicResource AccentGradBrush}"
                            HorizontalAlignment="Left" Width="0"/>
                  </Border>
                  <TextBlock x:Name="ProgressPct" Grid.Column="2" Text="0%" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                             FontFamily="{StaticResource UiFont}" Margin="10,0,0,0"/>
                  <TextBlock x:Name="ProgressStage" Grid.Column="3" Text="Idle" FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontFamily="{StaticResource UiFont}" Margin="10,0,0,0"/>
                  <Button x:Name="ClearLogBtn" Grid.Column="4" Content="Clear" Style="{StaticResource GhostBtn}"
                          Click="ClearLog_Click"/>
                </Grid>
                <TextBlock x:Name="ProgressDetail" Text="" FontSize="10"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                <Border CornerRadius="8" Background="{DynamicResource CardSunkenBrush}"
                        BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                  <TextBox x:Name="LogList" Background="{DynamicResource CardSunkenBrush}"
                           BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" Height="180"
                           IsReadOnly="True"
                           Padding="8,6"
                           VerticalContentAlignment="Top"
                           KeyDown="LogList_KeyDown"
                           TextWrapping="NoWrap"/>
                </Border>
              </StackPanel>
            </Border>
            <!-- Summary -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
              <StackPanel>
                <TextBlock x:Name="SummaryTitle" Text="RESULTS SUMMARY" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           FontFamily="{StaticResource UiFont}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Download" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SummaryDL" Text="--" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                             FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="Mbps" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Upload" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SummaryUL" Text="--" FontSize="12"
                             Foreground="{DynamicResource Accent2Brush}" FontWeight="SemiBold"
                             FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="Mbps" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Ping" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SummaryPing" Text="--" FontSize="12"
                             Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"
                             FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Jitter" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SummaryJitter" Text="--" FontSize="12"
                             Foreground="#FF6BFA" FontWeight="SemiBold"
                             FontFamily="{StaticResource UiFont}"/>
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="ms" FontSize="10"
                             Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      <!-- Status bar -->
      <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
              VerticalAlignment="Bottom" Height="28">
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusLeft" Text="Ready" FontSize="11"
                     Foreground="{DynamicResource TextDimBrush}"
                     FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusRight" Text="" FontSize="11"
                     Foreground="{DynamicResource TextDimBrush}"
                     FontFamily="{StaticResource UiFont}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Cursor="Hand" MouseLeftButtonDown="StatusRight_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Grid>
</Window>
