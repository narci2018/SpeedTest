                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Border Width="6" Height="6" Background="{DynamicResource SuccessBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Scheduled broadband speed tests" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Border Width="6" Height="6" Background="{DynamicResource SuccessBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Packet loss &amp; DNS resolution tracking" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Border Width="6" Height="6" Background="{DynamicResource SuccessBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
