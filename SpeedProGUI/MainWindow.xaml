<Window x:Class="SpeedPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedPro v3.9.0 — Network Performance Suite"
        Width="1520" Height="960"
        MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized">

  <!-- WPF native title bar (Mica-like surface) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  CornerRadius="0"
                  GlassFrameThickness="-1"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══════════════════════════ SIDEBAR ══════════════════════════ -->
    <Border Grid.Column="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="64"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Border Grid.Row="0"
                Background="Transparent"
                BorderBrush="{DynamicResource StrokeSoftBrush}"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Margin="18,0">
            <!-- Speed icon badge -->
            <Border Width="36" Height="36" Background="{DynamicResource AccentFillBrush}"
                    CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Path Data="{StaticResource IcoSpeed}" Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="SpeedPro" Foreground="{DynamicResource TextBrush}"
                         FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
              <TextBlock x:Name="SideSuite" Text="Network Suite" Foreground="{DynamicResource TextDimBrush}"
                         FontSize="10" FontFamily="{StaticResource UiFont}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Nav label -->
        <TextBlock x:Name="SideModules" Grid.Row="1" Text="MODULES"
                   Foreground="{DynamicResource TextDimBrush}"
                   FontSize="10.5" FontWeight="SemiBold"
                   FontFamily="{StaticResource UiFont}"
                   Margin="22,16,0,10" TextTrimming="CharacterEllipsis"/>

        <!-- Nav rail -->
        <StackPanel Grid.Row="2" Margin="8,0,8,0">
          <RadioButton x:Name="NavTest"    Content="Broadband Test"   Tag="{StaticResource IcoSpeed}"   Style="{StaticResource NavRailItem}" Click="Nav_Click" IsChecked="True" Margin="0,2"/>
          <RadioButton x:Name="NavWebsite" Content="Website Test"     Tag="{StaticResource IcoGlobe}"     Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavMonitor" Content="Monitor"          Tag="{StaticResource IcoMonitor}"   Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavIperf3"  Content="Iperf3 Throughput" Tag="{StaticResource IcoThroughput}" Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavEthr"    Content="Ethr Benchmark"    Tag="{StaticResource IcoBenchmark}" Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavPing"    Content="Pingularity"       Tag="{StaticResource IcoPing}"      Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavTools"   Content="Tools"             Tag="{StaticResource IcoTools}"     Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavHistory" Content="History"           Tag="{StaticResource IcoHistory}"   Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
          <RadioButton x:Name="NavSettings" Content="Settings"          Tag="{StaticResource IcoSettings}"  Style="{StaticResource NavRailItem}" Click="Nav_Click" Margin="0,2"/>
        </StackPanel>

        <!-- Live status -->
        <Border Grid.Row="3" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource StrokeSoftBrush}"
                BorderThickness="0,1,0,0" Padding="16,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#6F7686"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="LiveStatusText" Text="Idle"
                         FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                         FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"
                         Grid.Column="1"/>
            </Grid>
            <TextBlock x:Name="LiveIpText" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                       FontFamily="{StaticResource UiFont}" Margin="0,6,0,0" Text="IP: unknown"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="LiveIspText" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                       FontFamily="{StaticResource UiFont}" Margin="0,3,0,0" Text="ISP: unknown"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Text="v3.9.0 · 5 Engines"
                   FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                   FontFamily="{StaticResource UiFont}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ══════════════════════════ MAIN CONTENT ══════════════════════════ -->
    <Grid Grid.Column="1" Background="{DynamicResource BgBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- ── Title bar ── -->
      <Border x:Name="TitleBar" Background="{DynamicResource TitleBarBrush}"
              Height="40" VerticalAlignment="Top">
        <Grid>
          <TextBlock x:Name="HeaderTitle"
                     Text="Broadband Test" FontSize="13"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontFamily="{StaticResource UiFont}"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <!-- Language toggle -->
            <Button x:Name="LangBtn" Content="EN" FontSize="11" FontWeight="SemiBold"
                    Height="30" Padding="10,0" Margin="0,0,6,0"
                    Background="Transparent" BorderBrush="{DynamicResource StrokeSoftBrush}"
                    BorderThickness="1" Foreground="{DynamicResource TextMutedBrush}"
                    FontFamily="{StaticResource UiFont}" Click="LangToggle_Click"/>
            <!-- Theme quick switch (click to cycle) -->
            <Button x:Name="ThemeBtn" Content="◐" FontSize="14"
                    Height="30" Width="30" Margin="0,0,10,0"
                    Background="Transparent" BorderBrush="{DynamicResource StrokeSoftBrush}"
                    BorderThickness="1" Foreground="{DynamicResource TextMutedBrush}"
                    FontFamily="{StaticResource UiFont}" Click="ThemeToggle_Click"/>
            <Button Content="—" FontSize="10" Style="{StaticResource CaptionBtn}"
                    Width="46" Height="40" Click="Minimize_Click"/>
            <Button Content="□" FontSize="10" Style="{StaticResource CaptionBtn}"
                    Width="46" Height="40" Click="Maximize_Click"/>
            <Button Content="✕" FontSize="11" Style="{StaticResource CloseCaptionBtn}"
                    Width="46" Height="40" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Main layout: scrollable content + fixed bottom log ── -->
      <Grid Grid.Row="1" Margin="0,42,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable upper content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <!-- ════════════════════ BROADBAND TEST PANEL ════════════════════ -->
          <StackPanel x:Name="PanelTest" Grid.Row="0" Visibility="Visible">

            <!-- Top row: header + engine selector + start button -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QuickTitle" Grid.Column="0" Text="Quick Test" FontSize="15"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- Engine segmented picker -->
                  <Border Background="{DynamicResource CardSunkenBrush}"
                          BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="EngineLibreSpeed" Content="LibreSpeed"
                                   Style="{StaticResource SegmentedBtn}" IsChecked="True"
                                   Click="EngineChanged"/>
                      <RadioButton x:Name="EngineSpeedTestGo" Content="speedtest-go"
                                   Style="{StaticResource SegmentedBtn}"
                                   Click="EngineChanged"/>
                    </StackPanel>
                  </Border>
                  <!-- Server input：LibreSpeed=节点 ID/URL（空=自动）；speedtest-go=搜索关键字 -->
                  <TextBlock Text="Server" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                             FontFamily="{StaticResource UiFont}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  <TextBox x:Name="ServerInput" Width="170" Height="32" FontSize="12" Padding="10,6"
                           Text="" VerticalAlignment="Center"
                           ToolTip="LibreSpeed：服务器 ID 或 URL（留空 = 自动选择节点）&#x0a;speedtest-go：服务器搜索关键字"/>
                  <Button x:Name="ServerListBtn" Content="List" Style="{StaticResource GhostBtn}"
                          Height="32" Padding="10,0" Margin="6,0,0,0" Click="ServerList_Click"
                          ToolTip="列出 LibreSpeed 可用节点（含 ID）"/>
                  <!-- Start button -->
                  <Button x:Name="StartBtn" Content="? Start Test"
                          Style="{StaticResource PrimaryBtn}" Height="32" Padding="24,0"
                          Margin="12,0,0,0" Click="StartTest_Click"
                          FontFamily="{StaticResource UiFont}"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Middle row: charts | gauge | info -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto" MinWidth="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="260" MinWidth="220"/>
              </Grid.ColumnDefinitions>

              <!-- LEFT: Dual charts -->
              <StackPanel Grid.Column="0">
                <!-- Download chart -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <TextBlock x:Name="DlChartTitle" Text="Download Speed" FontSize="12"
                                 FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                      <TextBlock x:Name="DLChartPeak" Text="Peak: -- Mbps" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border CornerRadius="8" Background="{DynamicResource CardSunkenBrush}"
                            BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                      <Canvas x:Name="DLChartCanvas" Height="120"/>
                    </Border>
                  </StackPanel>
                </Border>
                <!-- Upload chart -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <TextBlock x:Name="UlChartTitle" Text="Upload Speed" FontSize="12"
                                 FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                      <TextBlock x:Name="ULChartPeak" Text="Peak: -- Mbps" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border CornerRadius="8" Background="{DynamicResource CardSunkenBrush}"
                            BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                      <Canvas x:Name="ULChartCanvas" Height="120"/>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- CENTER: Gauge + 4 metrics -->
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <!-- Hero gauge -->
                <Border Style="{StaticResource CardHero}" Margin="0,0,0,16">
                  <StackPanel HorizontalAlignment="Center">
                    <Canvas x:Name="GaugeCanvas" Width="220" Height="220"/>
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                      <TextBlock x:Name="GaugeValue" Text="0.00"
                                 Style="{StaticResource ValueBig}" FontSize="38"
                                 Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text="Mbps Download" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}"
                                 HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 4 metric cards -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Download -->
                  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                      <TextBlock Text="DOWNLOAD" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <TextBlock x:Name="MetricDL" Text="--" FontSize="30"
                                 FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                 FontFamily="{StaticResource UiFont}"
                                 TextOptions.TextFormattingMode="Display"/>
                      <TextBlock Text="Mbps" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                      <Border Height="3" CornerRadius="2" Background="{DynamicResource StrokeSoftBrush}"
                              Margin="0,10,0,0"><Border x:Name="DLBar" Height="3" CornerRadius="2"
                                                         Background="{DynamicResource AccentBrush}" Width="0"/></Border>
                    </StackPanel>
                  </Border>
                  <!-- Upload -->
                  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                      <TextBlock Text="UPLOAD" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <TextBlock x:Name="MetricUL" Text="--" FontSize="30"
                                 FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"
                                 FontFamily="{StaticResource UiFont}"
                                 TextOptions.TextFormattingMode="Display"/>
                      <TextBlock Text="Mbps" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                      <Border Height="3" CornerRadius="2" Background="{DynamicResource StrokeSoftBrush}"
                              Margin="0,10,0,0"><Border x:Name="ULBar" Height="3" CornerRadius="2"
                                                         Background="{DynamicResource Accent2Brush}" Width="0"/></Border>
                    </StackPanel>
                  </Border>
                  <!-- Ping -->
                  <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                      <TextBlock Text="PING" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <TextBlock x:Name="MetricPing" Text="--" FontSize="30"
                                 FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"
                                 FontFamily="{StaticResource UiFont}"
                                 TextOptions.TextFormattingMode="Display"/>
                      <TextBlock Text="ms avg" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                  </Border>
                  <!-- Jitter -->
                  <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                      <TextBlock Text="JITTER" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" Margin="0,0,0,6"/>
                      <TextBlock x:Name="MetricJitter" Text="--" FontSize="30"
                                 FontWeight="Bold" Foreground="#FF6BFA"
                                 FontFamily="{StaticResource UiFont}"
                                 TextOptions.TextFormattingMode="Display"/>
                      <TextBlock Text="ms std" FontSize="11"
                                 Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>

              <!-- RIGHT: Connection info + quality -->
              <StackPanel Grid.Column="4" VerticalAlignment="Top">
                <!-- Connection card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                  <StackPanel>
                    <TextBlock x:Name="ConnTitle" Text="CONNECTION" FontSize="11"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="24"/><RowDefinition Height="24"/>
                        <RowDefinition Height="24"/><RowDefinition Height="24"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoIP" Text="--"
                                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="ISP" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoISP" Text="--"
                                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Server" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoServer" Text="--"
                                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Country" FontSize="10"
                                 Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoCountry" Text="--"
                                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Quality score card -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock x:Name="ScoreTitle" Text="QUALITY SCORE" FontSize="11"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <!-- Ring gauge -->
                      <Border Grid.Column="0" x:Name="ScoreRingBorder" Width="72" Height="72"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="6"
                              CornerRadius="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ScoreRingText" Text="--" FontSize="22"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"/>
                      </Border>
                      <!-- Details -->
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="QualityLabel" Text="Run a test" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource UiFont}"/>
                        <TextBlock Text="Connection quality" FontSize="10"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   FontFamily="{StaticResource UiFont}" Margin="0,2,0,0"/>
                        <StackPanel Margin="0,10,0,0">
                          <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Download" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                                       FontFamily="{StaticResource UiFont}"/>
                            <Border Grid.Column="1" Height="3" CornerRadius="2"
                                    Background="{DynamicResource StrokeSoftBrush}" Margin="6,0,0,0">
                              <Border x:Name="QBarDL" Height="3" CornerRadius="2"
                                      Background="{DynamicResource AccentBrush}" Width="0"/>
                            </Border>
                          </Grid>
                          <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Upload" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                                       FontFamily="{StaticResource UiFont}"/>
                            <Border Grid.Column="1" Height="3" CornerRadius="2"
                                    Background="{DynamicResource StrokeSoftBrush}" Margin="6,0,0,0">
                              <Border x:Name="QBarUL" Height="3" CornerRadius="2"
                                      Background="{DynamicResource Accent2Brush}" Width="0"/>
                            </Border>
                          </Grid>
                          <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Latency" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                                       FontFamily="{StaticResource UiFont}"/>
                            <Border Grid.Column="1" Height="3" CornerRadius="2"
                                    Background="{DynamicResource StrokeSoftBrush}" Margin="6,0,0,0">
                              <Border x:Name="QBarPing" Height="3" CornerRadius="2"
                                      Background="{DynamicResource WarnBrush}" Width="0"/>
                            </Border>
                          </Grid>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Stability" FontSize="10" Foreground="{DynamicResource TextDimBrush}"
                                       FontFamily="{StaticResource UiFont}"/>
                            <Border Grid.Column="1" Height="3" CornerRadius="2"
                                    Background="{DynamicResource StrokeSoftBrush}" Margin="6,0,0,0">
                              <Border x:Name="QBarJitter" Height="3" CornerRadius="2"
                                      Background="#FF6BFA" Width="0"/>
                            </Border>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
          <!-- ════════════════════ MONITOR PANEL ════════════════════ -->
          <StackPanel x:Name="PanelMonitor" Grid.Row="0" Visibility="Hidden">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="300"/></Grid.ColumnDefinitions>
              <!-- Left: controls + log -->
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="CONTINUOUS MONITOR" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="URL" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" x:Name="MonitorUrl" FontSize="12" Padding="10,6"
                               Text="www.baidu.com" VerticalAlignment="Center"
                               ToolTip="定时探测的目标网址（自动使用 设置 → 代理服务器 的代理）"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Every" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                 FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="MonitorInterval" FontSize="12" Padding="10,6"
                                Width="110" HorizontalAlignment="Left" SelectedIndex="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="5 min"/><ComboBoxItem Content="10 min"/>
                        <ComboBoxItem Content="15 min"/><ComboBoxItem Content="30 min"/><ComboBoxItem Content="60 min"/>
                      </ComboBox>
                      <Button Grid.Column="2" x:Name="MonitorStartBtn" Content="Start Monitor" Style="{StaticResource PrimaryBtn}"
                              Height="32" Padding="20,0" MinWidth="140" Click="MonitorStart_Click"/>
                    </Grid>
                    <TextBlock x:Name="MonitorStatus" Text="Stopped" FontSize="11"
                               Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Runs a 1-sample website check on schedule, in the background; samples persist to monitor.json. Uses the proxy configured in Settings."
                               FontSize="10.5" Foreground="{DynamicResource TextDimBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Height="200">
                  <StackPanel>
