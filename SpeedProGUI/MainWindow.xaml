                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="WebInfoStatus" Text="--" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="IP" FontSize="10" Foreground="{DynamicResource TextDimBrush}" FontFamily="{StaticResource UiFont}"/>
