                                   Text="Start the service, then the dashboard loads here (WebView2).&#x0a;Or use “Open Dashboard” to open it in your browser."
                                   FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   FontFamily="{StaticResource UiFont}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="ABOUT PINGULARITY" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               LineHeight="22" FontFamily="{StaticResource UiFont}">
                      <Run Foreground="{DynamicResource Accent2Brush}" FontWeight="Bold">24/7 Network Monitoring</Run><LineBreak/>
                      Records latency trends, packet loss, DNS, and route jitter over time.<LineBreak/><LineBreak/>
                      <Run Foreground="{DynamicResource AccentBrush}" FontWeight="Bold">Features:</Run><LineBreak/>
                      Automatic speed tests (Ookla + iperf3)<LineBreak/>
                      Dashboard with heatmap &amp; alerts<LineBreak/>
                      SQLite database for long-term storage<LineBreak/>
