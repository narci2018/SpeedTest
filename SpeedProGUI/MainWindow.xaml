                      <TextBlock Grid.Row="6" Grid.Column="1" x:Name="WebInfoRedirects" Text="--" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center"/>
